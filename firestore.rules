rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function moderator() { return signedIn() && request.auth.token.moderator == true; }
  match /profiles/{uid} {
   allow read, delete: if signedIn() && request.auth.uid == uid;
   allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.ownerId == uid;
  }
  // Match cards and published work are curated projections, written only by a trusted server.
  match /publicProfiles/{uid} { allow read: if signedIn(); allow write: if false; }
  match /stories/{id} { allow read: if resource.data.status == 'published'; allow write: if false; }
  match /drafts/{id} {
   allow create: if signedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.status == 'draft' && request.resource.data.title is string && request.resource.data.title.size() <= 120 && request.resource.data.body is string && request.resource.data.body.size() <= 15000;
   allow read, delete: if signedIn() && resource.data.authorId == request.auth.uid;
   allow update: if signedIn() && resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId && request.resource.data.status == 'draft' && request.resource.data.title is string && request.resource.data.title.size() <= 120 && request.resource.data.body is string && request.resource.data.body.size() <= 15000;
  }
  // Invitations, adult eligibility, mutual consent, publication and withdrawal require server validation.
  match /invitations/{id} { allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid); allow write: if false; }
  match /reports/{id} {
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['reporterId','storyId','reason','createdAt']) && request.resource.data.reporterId == request.auth.uid && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 2000 && request.resource.data.createdAt == request.time;
   allow read: if moderator(); allow update, delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
